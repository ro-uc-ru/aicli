"""Claude provider: settings and an async completion client."""

from pydantic_settings import BaseSettings, SettingsConfigDict

from app.ai.llm import base

BASE_URL = "https://api.anthropic.com"


class Settings(BaseSettings):
    """Settings read from ANTHROPIC_* variables and the root .env file."""

    model_config = SettingsConfigDict(
        env_prefix="ANTHROPIC_", env_file=".env", extra="ignore"
    )

    api_key: str | None = None
    model: str | None = None


def _load_settings() -> dict[str, str | None]:
    """Return the value of each required variable, ``None`` when unset."""
    settings = Settings()
    return {"ANTHROPIC_API_KEY": settings.api_key, "ANTHROPIC_MODEL": settings.model}


class ClaudeClient:
    """Async client of the Anthropic messages API."""

    def __init__(self, api_key: str, model: str) -> None:
        self.api_key = api_key
        self.model = model

    async def complete(
        self,
        messages: list[base.Message],
        system: str | None = None,
        max_tokens: int = 1024,
    ) -> str:
        """Return the text generated for ``messages``."""
        import anthropic

        turns = [{"role": m.role, "content": m.content} for m in messages]
        options = {"system": system} if system else {}
        async with anthropic.AsyncAnthropic(
            api_key=self.api_key, base_url=BASE_URL
        ) as sdk:
            response = await sdk.messages.create(
                model=self.model, max_tokens=max_tokens, messages=turns, **options
            )
        return "".join(b.text for b in response.content if b.type == "text")

    # aicli:methods


def _make_client() -> ClaudeClient:
    """Build the client from the settings."""
    settings = Settings()
    return ClaudeClient(
        (settings.api_key or "").strip(), (settings.model or "").strip()
    )


PROVIDER = base.ProviderDescriptor(
    name="claude",
    position=2,
    required=("ANTHROPIC_API_KEY", "ANTHROPIC_MODEL"),
    load_settings=_load_settings,
    make_client=_make_client,
)
